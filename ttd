          for _,k in ipairs(K) do if l:find(k,1,true) then push(rk,it) break end end
          if not lkf then tgt=it end
          ui()
        end
      end
      return old(se,...)
    end
    if ro then ro(mt,true) end
  end)
  print(ok and "S3 RMT OK" or "S3 RMT ERR")
else
