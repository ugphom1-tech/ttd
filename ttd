local function gems()
  local v=0
  pcall(function()
    local ls=LP:FindFirstChild("leaderstats")
    if ls then for _,c in ipairs(ls:GetChildren()) do if c.Name:lower():find("gem") then v=math.max(v,tonumber(c.Value) or 0) end end end
  end)
  if v>0 then return v end
  pcall(function()
    for _,d in ipairs(pg:GetDescendants()) do
      if d:IsA("TextLabel") and d.Visible and d.Text:lower():find("gem") then
        local n=tonumber((d.Text:gsub("[^%d]","")))
        if n and n>v then v=n end
      end
    end
  end)
  return v
end
local function sps(e)
  local t={}
  pcall(function() if raknet then t[#t+1]=raknet end end)
  pcall(function() if rnet then t[#t+1]=rnet end end)
  local d=e.a or e.s
  for _,x in ipairs(t) do
    for _,k in ipairs({"send","sendPacket"}) do
      local fd
      pcall(function() fd=x[k] end)
      if type(fd)=="function" and (pcall(fd,d) or pcall(fd,x,d)) then return true end
    end
  end
  return false
end
local function onpk(p)
  local id
  pcall(function() id=p.PacketId end)
  if not id then pcall(function() id=p.id end) end
  if id~=131 then return end
  local a,z
  pcall(function() a=p:AsArray() end)
  if type(a)~="table" then pcall(function() a=p.data end) end
  pcall(function() z=p:AsString() end)
  if type(z)~="string" then pcall(function() z=p.Data end) end
  if type(a)=="table" and #a>0 and #a<=400 then push(pk,{a=a})
  elseif type(z)=="string" and #z>0 and #z<=400 then push(pk,{s=z})
  else return end
  ui()
end
pcall(function()
  local a1=raknet and (raknet.add_send_hook or raknet.addSendHook)
  if type(a1)=="function" then a1(onpk) return end
  if raknet and raknet.Capture then raknet.Capture:Connect(onpk) end
end)
pcall(function() if rnet and type(rnet.add_send_hook)=="function" then rnet.add_send_hook(onpk) end end)
