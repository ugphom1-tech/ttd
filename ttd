local function fire(r) r.o[r.m](r.o,table.unpack(r.a,1,r.c)) end
local function work()
  local r=tgt
  local e=pk[#pk]
  if not r and not e then s.Text="chua ghi" return end
  if run then run=false return end
  run=true
  b.Text="STOP"
  b.BackgroundColor3=Color3.fromRGB(220,70,70)
  local n=mul
  local gb=gems()
  local gp=gb
  local dead=0
  local sent=0
  pcall(function()
    for i=1,n do
      if not run then break end
      if e then
        task.spawn(function() pcall(sps,e) end)
      else
        task.spawn(function() pcall(fire,r) end)
      end
      if md==2 then task.wait(0.03) end
      if i%40==0 then
        task.wait()
        local gg=gems()
        if gg>gp then dead=0 gp=gg else dead=dead+1 end
        sent=i
        s.Text=sent.."/"..n
        if dead>=4 then break end
      end
    end
  end)
  run=false
  b.Text="DUPE"
  b.BackgroundColor3=Color3.fromRGB(36,200,110)
  local gg=gems()
  if gb>0 and gg>gb then
    gl.Text="+"..(gg-gb).." gem"
    gl.TextColor3=Color3.fromRGB(120,230,140)
  elseif dead>=4 then
    gl.Text="dung: khong an"
    gl.TextColor3=Color3.fromRGB(230,120,120)
  else
    gl.Text="xong "..sent.." lan"
  end
end
