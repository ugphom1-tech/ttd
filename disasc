local function deepcopy(v, seen)
	seen = seen or {}
	local tv = type(v)
	if tv ~= "table" then return v end
	if seen[v] then return seen[v] end
	local o = {}
	seen[v] = o
	for k, x in pairs(v) do o[deepcopy(k, seen)] = deepcopy(x, seen) end
	return o
end

local function hex(s)
	local n = math.min(#s, MAXLEN)
	local t = table.create(n)
	for i = 1, n do t[i] = string.format("%02X", s:byte(i)) end
	local o = table.concat(t, " ")
	if #s > n then o ..= (" +%d"):format(#s - n) end
	return o
end

local function asc(s)
	return (s:sub(1, math.min(#s, MAXLEN)):gsub("[^\32-\126]", "."))
end

local function walk(v, path, out)
	local tv = type(v)
	if tv == "table" then
		for k, x in pairs(v) do
			walk(x, type(k) == "number" and (path .. "[" .. k .. "]") or (path .. "." .. tostring(k)), out)
		end
	elseif tv == "string" then
		out[#out + 1] = ("%s len=%d HEX=%s ASC=%s"):format(path, #v, hex(v), asc(v))
	elseif tv == "Instance" then
		out[#out + 1] = ("%s Instance=%s"):format(path, v:GetFullName())
	else
		out[#out + 1] = ("%s %s=%s"):format(path, tv, tostring(v))
	end
end

