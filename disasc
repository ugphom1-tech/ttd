	local acc = head
	for line in (text .. "\n"):gmatch("(.-)\n") do
		if #acc + #line > 1850 then
			post(acc)
			task.wait(0.8)
			acc = ""
		end
		acc ..= line .. "\n"
	end
	if #acc > 0 then post(acc) end
end

local function flush()
	if #buf == 0 then return end
	local text = table.concat(buf, "\n")
	table.clear(buf)
	if writefile then pcall(writefile, ("d8_%d.txt"):format(os.time()), text) end
	send(text)
end

local function capture(inst, args)
	local okp, err = pcall(function()
		count += 1
		local i = count
		store[i] = { inst = inst, args = deepcopy(args) }
		local out = { ("=== %d %s n=%d"):format(i, inst:GetFullName(), #args) }
		for k = 1, #args do walk(args[k], "a" .. k, out) end
		local block = table.concat(out, "\n")
		buf[#buf + 1] = block
		total += #block
		print(block)
	end)
	if not okp then print("CAP ERR " .. tostring(err)) end
	if count >= MAXCAP or total >= MAXTOTAL then disarm() end
end

