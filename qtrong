local RS, PLR = game:GetService("ReplicatedStorage"), game:GetService("Players").LocalPlayer
local R = RS:WaitForChild("NetworkingContainer"):WaitForChild("DataRemote")

local function tohex(s) local t={} for i=1,#s do t[i]=("%02X"):format(s:byte(i)) end return table.concat(t) end
local function rnd16()
  if crypt and crypt.generatebytes then local ok,b = pcall(crypt.generatebytes,16)
    if ok and type(b)=="string" and #b==16 then return b end end
  local t={} for i=1,16 do t[i]=string.char(math.random(0,255)) end return table.concat(t)
end

local gemNode
local function findGem()
  local seen, q = {}, { {PLR, 0} }
  while #q > 0 do
    local node, d = q[1][1], q[1][2]
    table.remove(q, 1)
    if node and not seen[node] then
      seen[node] = true
      if node ~= PLR and (node:IsA("IntValue") or node:IsA("NumberValue"))
         and node.Name:lower():find("gem") then return node end
      if d < 3 then
        for _, c in ipairs(node:GetChildren()) do
          if not c:IsA("BasePart") and not c:IsA("Model") then q[#q+1] = {c, d+1} end
        end
      end
    end
  end
end
local function readHud()
  for _, d in ipairs(PLR.PlayerGui:GetDescendants()) do
    if d:IsA("TextLabel") then
      local a = d.Parent
      for _ = 1, 3 do
        if a and a.Name:lower():find("gem") then
          local n = d.Text:match("^([%d,]+)$")
          if n then return tonumber((n:gsub(",",""))) end
        end
        a = a and a.Parent
      end
    end
  end
end
local function gems()
  if gemNode and gemNode.Parent then return gemNode.Value end
  gemNode = findGem()
  if gemNode then return gemNode.Value end
  return readHud()
end

