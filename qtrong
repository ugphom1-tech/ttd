-- capture
local prev, mode, raw, armed = nil, nil, {}, false

local function unhook()
  if not prev then return end
  local p, m = prev, mode
  prev, armed = nil, false
  if m == "nm" then pcall(hookmetamethod, game, "__namecall", p)
  else pcall(hookfunction, R.FireServer, p) end
end

local function onfire(tbl)
  if #raw >= 12 then return end
  raw[#raw+1] = tbl
  local lines = {}
  for _, p in ipairs(raw) do
    lines[#lines+1] = table.concat({ tohex(p[1] or ""), tohex(p[2] or ""), p[3] or "" }, "|")
  end
  box.Text = table.concat(lines, "\n")
  status.Text = ("da bat %d fire"):format(#raw)
end

local function grab(self, ...)
  if self ~= R and not (typeof(self) == "Instance" and self.Name == "DataRemote") then return end
  local a = select(1, ...)
  if type(a) == "table" then onfire(a) end
end

local function arm()
  if armed then return end
  raw, armed = {}, true
  box.Text = ""
  if hookmetamethod and getnamecallmethod then
    mode = "nm"
    prev = hookmetamethod(game, "__namecall", function(self, ...)
      if armed then pcall(grab, self, ...) end
      if prev then return prev(self, ...) end
    end)
  else
    mode = "hf"
    prev = hookfunction(R.FireServer, function(...)
      if armed then pcall(grab, R, ...) end
      if prev then return prev(...) end
    end)
  end
  status.Text = "dang bat - bam Claim/Summon ngay"
  task.delay(20, function() if armed then unhook() status.Text = "het gio bat" end end)
end

-- fire
local count = 2
local function fire()
  local b = parse(box.Text)
  if #b == 0 then status.Text = "payload rong hoac sai format" return end
  if armed then unhook() end
  status.Text = ("ban %dx%d fire"):format(count, #b)
  task.spawn(function()
    for i = 1, count do
      for _, p in ipairs(b) do
        local q = { p[1], rnd16() }
        if p[3] then q[3] = p[3] end
        pcall(function() R:FireServer(q) end)
        task.wait(0.12)
      end
      task.wait(0.35)
    end
    status.Text = "xong"
  end)
end

