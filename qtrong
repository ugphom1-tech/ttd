local function hx(s) return (s:gsub("%s+",""):gsub("%x%x", function(c) return string.char(tonumber(c,16)) end)) end
local function tohex(s) local t={} for i=1,#s do t[i]=("%02X"):format(s:byte(i)) end return table.concat(t) end
local function rnd16()
  if crypt and crypt.generatebytes then local ok,b = pcall(crypt.generatebytes,16)
    if ok and type(b)=="string" and #b==16 then return b end end
  local t={} for i=1,16 do t[i]=string.char(math.random(0,255)) end return table.concat(t)
end

local function parse(txt)
  local out = {}
  for line in txt:gmatch("[^\r\n]+") do
    local a,b,c = line:match("^([%x]+)|([%x]+)|?([%x]*)$")
    if a and b then
      local p = { hx(a), hx(b) }
      if c and c ~= "" then p[3] = c end
      out[#out+1] = p
    end
  end
  return out
end

