local prev, mode, raw, armed, quiet = nil, nil, {}, false, nil
local COUNT, TARGET, FAST, LOG = 3, 1140, false, {}

local function unhook()
  if not prev then return end
  local p, m = prev, mode
  prev, armed = nil, false
  if quiet then task.cancel(quiet) quiet = nil end
  if m == "nm" then pcall(hookmetamethod, game, "__namecall", p)
  else pcall(hookfunction, R.FireServer, p) end
end

local function replay()
  if #raw == 0 then st.Text = "khong bat duoc fire - hook chet" return end
  local p = raw[#raw]
  local before = gems()
  if before then gl.Text = "truoc: " .. before end
  st.Text = ("ban %d vong"):format(COUNT)
  task.spawn(function()
    for i = 1, COUNT do
      pcall(function() R:FireServer({ p[1], rnd16(), p[3] }) end)
      task.wait(FAST and 0.08 or 0.14)
      local now = gems()
      if now then gl.Text = "gem: " .. now end
      if TARGET > 0 and now and now >= TARGET then st.Text = "cham " .. TARGET return end
    end
    local after = gems()
    if before and after then
      local d = after - before
      st.Text = d > 0 and ("+%d gem"):format(d) or "khong tang"
      gl.Text = "gem: " .. after
    else st.Text = "xong" end
  end)
end

local function onfire(tbl)
  if #raw >= 6 then return end
  raw[#raw+1] = tbl
  LOG[#LOG+1] = ("%d op=%s a2=%dB%s"):format(#raw, tohex(tbl[1] or ""), #(tbl[2] or ""), tbl[3] and " +sig" or "")
  st.Text = table.concat(LOG, "\n", math.max(1, #LOG - 3))
  if quiet then task.cancel(quiet) end
  quiet = task.delay(FAST and 0.2 or 0.8, function() unhook() replay() end)
end

local function grab(self, ...)
  if self ~= R and not (typeof(self) == "Instance" and self.Name == "DataRemote") then return end
  local a = select(1, ...)
  if type(a) == "table" then onfire(a) end
end

local function arm(withReplay)
  if armed then return end
  raw, LOG, armed = {}, {}, true
  if hookmetamethod and getnamecallmethod then
    mode = "nm"
    prev = hookmetamethod(game, "__namecall", function(self, ...)
      if armed then pcall(grab, self, ...) end
      if prev then return prev(self, ...) end
    end)
  else
    mode = "hf"
    prev = hookfunction(R.FireServer, function(...)
      if armed then pcall(grab, R, ...) end
      if prev then return prev(...) end
    end)
  end
  st.Text = withReplay and "DANG BAT - bam claim/accept NGAY" or "CHI BAT - bam nut bat ky"
  task.delay(withReplay and 8 or 15, function()
    if armed and #raw == 0 then unhook() st.Text = "khong thay fire nao - hook chet" end
  end)
end

