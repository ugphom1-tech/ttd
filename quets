local function mkbtn(text, y, color)
	local b = Instance.new("TextButton")
	b.Size, b.Position = UDim2.new(1, -8, 0, 28), UDim2.fromOffset(4, y)
	b.BackgroundColor3, b.BorderSizePixel = color, 0
	b.TextColor3, b.Font, b.TextSize, b.Text = Color3.new(1, 1, 1), Enum.Font.GothamMedium, 13, text
	b.Parent = main
	return b
end

local function replay(i)
	local rec = store[i]
	if not rec then return end
	print(("[REPLAY %d]"):format(i))
	busy = true
	local ok2, err = pcall(function() target:FireServer(unpack(rec)) end)
	busy = false
	if not ok2 then print("replay err", err) end
end

local bArm = mkbtn("ARM 15s", 236, Color3.fromRGB(40, 90, 160))
local bAll = mkbtn("REPLAY ALL", 268, Color3.fromRGB(40, 90, 160))
local bClr = mkbtn("CLEAR", 300, Color3.fromRGB(60, 60, 66))
local bStop = mkbtn("STOP HOOK", 332, Color3.fromRGB(140, 45, 45))

bAll.MouseButton1Click:Connect(function()
	task.spawn(function()
		for i = 1, count do
			replay(i)
			task.wait(0.25)
		end
	end)
end)

bClr.MouseButton1Click:Connect(function()
	table.clear(store)
	count = 0
	bAll.Text = "REPLAY ALL"
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	print("CLEARED")
end)

local function addButton(i)
	local b = Instance.new("TextButton")
	b.Size, b.BackgroundColor3, b.BorderSizePixel = UDim2.new(1, 0, 0, 26), Color3.fromRGB(38, 38, 44), 0
	b.TextColor3, b.Font, b.TextSize = Color3.fromRGB(200, 220, 255), Enum.Font.Code, 13
	b.Text = ("#%d replay"):format(i)
	b.Parent = list
	b.MouseButton1Click:Connect(function() replay(i) end)
end

local function disarm()
	if not armed then return end
	armed = false
	if old then
		local o = old
		old = nil
		pcall(function() hookmetamethod(game, "__namecall", o) end)
	end
	bArm.Text, bArm.BackgroundColor3 = "ARM 15s", Color3.fromRGB(40, 90, 160)
	print("DISARMED")
end

local function arm()
	if armed then return end
	armed = true
	bArm.Text, bArm.BackgroundColor3 = "ARMED - claim now", Color3.fromRGB(30, 120, 60)
	print("ARMED 15s")
	local prev
	prev = hookmetamethod(game, "__namecall", function(self, ...)
		if self ~= target or busy then return prev(self, ...) end
		local m = getnamecallmethod()
		if m == "FireServer" then
			local args = { ... }
			count += 1
			local i = count
			store[i] = deepcopy(args)
			local out = { ("=== %d n=%d"):format(i, #args) }
			for k = 1, #args do walk(args[k], "a" .. k, out) end
			print(table.concat(out, "\n"))
			addButton(i)
			bAll.Text = "REPLAY ALL (" .. count .. ")"
			if count >= MAXCAP then disarm() end
		elseif m == "Fire" then
			local r = { ... }
			local k = {}
			for j = 1, #r do k[j] = type(r[j]) end
			print(("--- SRV %d: %d args [%s]"):format(count, #r, table.concat(k, ",")))
		end
		return prev(self, ...)
	end)
	old = prev
	task.delay(ARMTIME, disarm)
end

bArm.MouseButton1Click:Connect(arm)
bStop.MouseButton1Click:Connect(disarm)
print("D5 ready")
