local RS = game:GetService("ReplicatedStorage")
local target = RS:FindFirstChild("DataRemote", true)
assert(target, "DataRemote not found")

local unpack = table.unpack or unpack

local function deepcopy(v, seen)
	seen = seen or {}
	local tv = type(v)
	if tv ~= "table" then return v end
	if seen[v] then return seen[v] end
	local out = {}
	seen[v] = out
	for k, x in pairs(v) do out[deepcopy(k, seen)] = deepcopy(x, seen) end
	return out
end

local function asc(s) return (s:gsub("[^\32-\126]", ".")) end

local function hx(s)
	local t = table.create(#s)
	for i = 1, #s do t[i] = string.format("%02X", s:byte(i)) end
	return table.concat(t, " ")
end

local store, count = {}, 0

local function dump(v, path, depth)
	depth = depth or 0
	local tv = type(v)
	if tv == "table" then
		if depth > 3 then print(path .. " = <nested>") return end
		print(path .. " = table")
		for k, x in pairs(v) do
			local kp = path .. "{" .. tostring(k) .. "}"
			dump(k, kp .. "<K>", depth + 1)
			dump(x, kp, depth + 1)
		end
	elseif tv == "string" then
		print(("%s = string len=%d"):format(path, #v))
		print(path .. " ASC: " .. asc(v))
		print(path .. " HEX: " .. hx(v))
	else
		print(("%s = %s %s"):format(path, tv, tostring(v)))
	end
end

