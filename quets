local function replay(i)
	local rec = store[i]
	if not rec then return end
	print(("[REPLAY %d]"):format(i))
	local ok2, err = pcall(function() target:FireServer(unpack(rec)) end)
	if not ok2 then print("replay err", err) end
end

local bAll = mkbtn("REPLAY ALL", 252, Color3.fromRGB(40, 90, 160))
local bClr = mkbtn("CLEAR", 284, Color3.fromRGB(60, 60, 66))
local bStop = mkbtn("STOP HOOK", 316, Color3.fromRGB(140, 45, 45))

bAll.MouseButton1Click:Connect(function()
	task.spawn(function()
		for i = 1, count do
			replay(i)
			task.wait(0.2)
		end
	end)
end)

bClr.MouseButton1Click:Connect(function()
	table.clear(store)
	count = 0
	bAll.Text = "REPLAY ALL"
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	print("CLEARED")
end)

local function addButton(i)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 26)
	b.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
	b.BorderSizePixel = 0
	b.TextColor3 = Color3.fromRGB(200, 220, 255)
	b.Font = Enum.Font.Code
	b.TextSize = 13
	b.Text = ("#%d replay"):format(i)
	b.Parent = list
	b.MouseButton1Click:Connect(function() replay(i) end)
end

local old
old = hookmetamethod(game, "__namecall", function(self, ...)
	local m = getnamecallmethod()
	if self == target then
		if m == "FireServer" then
			local args = { ... }
			count += 1
			local i = count
			store[i] = deepcopy(args)
			print(("=== %d | t=%.2f | n=%d"):format(i, os.clock(), #args))
			for k = 1, #args do dump(args[k], "arg" .. k) end
			addButton(i)
			bAll.Text = "REPLAY ALL (" .. count .. ")"
		elseif m == "Fire" then
			print(("--- SERVER %d | t=%.2f"):format(count, os.clock()))
			local r = { ... }
			for k = 1, #r do dump(r[k], "srv" .. k) end
		end
	end
	return old(self, ...)
end)

print("D4 ready")

local stopped = false
local function stop()
	if stopped then return end
	stopped = true
	pcall(function() hookmetamethod(game, "__namecall", old) end)
	print("HOOK OFF")
end

bStop.MouseButton1Click:Connect(stop)
task.delay(60, stop)
