local function readGem()
	local best=0
	pcall(function()
		local ls=LP:FindFirstChild("leaderstats")
		if ls then for _,v in ipairs(ls:GetChildren()) do local n=v:IsA("ValueBase") and tonumber(v.Value) if n and n>best then best=n end end end
		for _,d in ipairs(PG:GetDescendants()) do if d:IsA("TextLabel") and d.Text:lower():find("gem") then local n=tonumber((d.Text:gsub("[^%d]",""))) if n and n>best then best=n end end end
	end)
	return best
end
local function sendPkt(p)
	local lib=raknet or rnet
	if not lib then return false end
	if pcall(function() lib.send(lib,p) end) then return true end
	return pcall(function() lib.send(p) end)
end
local function sendRemote(e)
	if not e.r then return false end
	return pcall(function()
		if e.m=="InvokeServer" then e.r:InvokeServer(table.unpack(e.a,1,e.n)) else e.r:FireServer(table.unpack(e.a,1,e.n)) end
	end)
end
local function fire(key,e)
	local f=key=="P" and sendPkt or sendRemote
	if mode=="BURST" then
		task.spawn(function() busy[key]=true local ok=f(e) busy[key]=false if not ok then fails=fails+1 end end)
	else
		busy[key]=true local ok=f(e) busy[key]=false if not ok then fails=fails+1 end
	end
end
local function onNamecall(self,...)
	local m=getnamecallmethod()
	if m=="FireServer" or m=="InvokeServer" then
		local okn,nm=pcall(tostring,self)
		if okn and type(nm)=="string" and not locked then
			local n=select("#",...)
			local a={...}
			local l=nm:lower()
			local hit=l:find("gem")or l:find("claim")or l:find("reward")or l:find("crate")or l:find("spin")or l:find("daily")or l:find("quest")or l:find("box")or l:find("summon")or l:find("sell")or l:find("buy")or l:find("coin")or l:find("unit")or l:find("place")or l:find("trade")or l:find("accept")or l:find("mail")or l:find("post")
			if hit then if #prim>40 then table.remove(prim,1) end prim[#prim+1]={r=self,a=a,n=n,m=m,name=nm} targetLbl.Text="R: "..nm
			else if #sec>40 then table.remove(sec,1) end sec[#sec+1]={r=self,a=a,n=n,m=m,name=nm} end
		end
	end
	if type(old)=="function" then return old(self,...) end
end
local hooked=false
if hookmetamethod then
	local ok=pcall(function() old=hookmetamethod(game,"__namecall",onNamecall) end)
	if ok and type(old)=="function" then hooked=true end
end
if not hooked then
	local mt=getrawmetatable(game)
	if mt then
		local ok=pcall(function()
			setreadonly(mt,false)
			old=mt.__namecall
			local f=onNamecall
			if newcclosure then local oc,nc=pcall(newcclosure,onNamecall) if oc then f=nc end end
			mt.__namecall=f
			setreadonly(mt,true)
		end)
		if ok and type(old)=="function" then hooked=true end
	end
end
