local pktOk=false
local function onPkt(p)
	pcall(function()
		if #pkts>=8 then return end
		local id local a1,b1=pcall(function() return p.PacketId end) local a2,b2=pcall(function() return p.id end)
		if a1 and type(b1)=="number" then id=b1 elseif a2 and type(b2)=="number" then id=b2 end
		if id~=131 then return end
		local by local a3,b3=pcall(function() return p:AsArray() end) local a4,b4=pcall(function() return p.AsArray(p) end)
		if a3 and b3 then by=b3 elseif a4 and b4 then by=b4 end
		local st local a5,b5=pcall(function() return p:AsString() end) local a6,b6=pcall(function() return p.Data end)
		if a5 and b5 then st=b5 elseif a6 and b6 then st=b6 end
		local len=(type(by)=="table" and #by) or (type(st)=="string" and #st) or 0
		if len==0 or len>400 then return end
		pkts[#pkts+1]=p
		targetLbl.Text="PKT #"..tostring(#pkts)
	end)
end
local function tryHook(lib,tag)
	if not lib or type(lib)=="function" then return false end
	for _,n in ipairs({"add_send_hook","addSendHook","add_outgoing_hook","addOutgoingHook","HookOutgoing","hook_outgoing","on_send","onSend"}) do
		local ok,v=pcall(function() return lib[n] end)
		if ok and type(v)=="function" then
			local o,e=pcall(function() lib[n](lib,onPkt) end)
			if not o then o,e=pcall(function() lib[n](onPkt) end) end
			print(tag.."."..n.." -> "..(o and "OK" or ("LOI "..tostring(e))))
			if o then pktOk=true return true end
		end
	end
	for _,n in ipairs({"Capture","capture","SendHook"}) do
		local ok,v=pcall(function() return lib[n] end)
		if ok and v then
			local o,e
			if type(v)=="function" then o,e=pcall(function() lib[n](lib,onPkt) end)
			elseif type(v)=="table" or type(v)=="userdata" then o,e=pcall(function() v:Connect(onPkt) end) end
			print(tag.."."..n.." -> "..(o and "OK" or ("LOI "..tostring(e))))
			if o then pktOk=true return true end
		end
	end
	return false
end
local function hookPkt()
	if raknet then pcall(function() if raknet.start_capture then raknet.start_capture(raknet) end if raknet.startCapture then raknet.startCapture(raknet) end end) end
	if not tryHook(raknet,"raknet") then tryHook(rnet,"rnet") end
	if pktOk then print("S2 PKT OK") else print("S2 PKT NO") end
end
hookPkt()
local btnDupe
local function stopRun() running=false btnDupe.Text="DUPE" end
local function startRun()
	if running then stopRun() status.Text="da dung" return end
	if busy.P or busy.R then status.Text="dang ban" return end
	local usePkt=#pkts>0 local list=usePkt and pkts or (#prim>0 and prim or sec)
	if #list==0 then status.Text="chua bat duoc goi tin" return end
	local g0=readGem() local gs=g0
	gemLbl.Text="gem: "..tostring(g0) targetLbl.Text=usePkt and "PKT 0x83" or ("R: "..tostring(list[1].name))
	sent=0 fails=0 running=true btnDupe.Text="STOP"
	task.spawn(function()
		local i=0 local why=nil
		while running and sent<mult do
			local e=list[(i%#list)+1]
			local isB=mode=="BURST"
			fire(usePkt and "P" or "R",e)
			sent=sent+1 i=i+1
			if not isB then task.wait(0.03) end
			if sent%40==0 then
				if isB then task.wait() end
				local g=readGem() gemLbl.Text="gem: "..tostring(g)
				if g>g0 then g0=g fails=0 else fails=fails+1 end
				if fails>=4 then why="dung: khong an" running=false end
			end
		end
		running=false btnDupe.Text="DUPE"
		local g1=readGem() gemLbl.Text="gem: "..tostring(g1)
		local d=g1-gs
		if why then status.Text=why elseif d>0 then status.Text="+"..tostring(d).." gem" else status.Text="xong: "..tostring(sent).." +0" end
	end)
end
