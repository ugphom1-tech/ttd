-- HOOK REMOTES
local KW = {"gem","currency","transfer","balance","coin","credit","spend","purchase","shop","buy","sell","add","remove"}

local function match(n)
    local l = n:lower()
    for _,k in ipairs(KW) do if l:find(k) then return true end end
    return false
end

local hooked = 0
local logs = {}

local function hook(p, d)
    d = d or 0
    if d > 6 then return end
    for _,c in ipairs(p:GetChildren()) do
        if c:IsA("RemoteEvent") and match(c.Name) then
            hooked = hooked + 1
            table.insert(logs, "RE: "..c:GetFullName())
            c.OnClientEvent:Connect(function(...)
                local a = {}
                for i=1,select("#",...) do
                    local v = select(i,...)
                    if typeof(v)=="string" then a[#a+1]='"'..v:sub(1,30)..'"'
                    elseif typeof(v)=="number" then a[#a+1]=tostring(v)
                    else a[#a+1]=typeof(v) end
                end
                table.insert(logs, "  >> "..c.Name..": "..table.concat(a,", "))
                wh("EVENT ["..c.Name.."]: "..table.concat(a,", "))
            end)
        elseif c:IsA("RemoteFunction") and match(c.Name) then
            hooked = hooked + 1
            table.insert(logs, "RF: "..c:GetFullName())
            local orig = c.InvokeServer
            c.InvokeServer = function(self, ...)
                local a = {}
                for i=1,select("#",...) do
                    local v = select(i,...)
                    if typeof(v)=="string" then a[#a+1]='"'..v:sub(1,30)..'"'
                    elseif typeof(v)=="number" then a[#a+1]=tostring(v)
                    else a[#a+1]=typeof(v) end
                end
                wh("CALL ["..self.Name.."]: "..table.concat(a,", "))
                local r = orig(self, ...)
                wh("  RET: "..tostring(r))
                return r
            end
        end
        hook(c, d+1)
    end
end

