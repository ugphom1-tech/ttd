-- ==================== 1. SCAN LOCALSCRIPTS ====================
local found = {}
local function scanScripts(p, d)
    d = d or 0
    if d > 8 then return end
    for _,c in ipairs(p:GetChildren()) do
        if c:IsA("LocalScript") or c:IsA("ModuleScript") then
            local src = ""
            pcall(function()
                if c:IsA("LocalScript") then
                    src = c.Source or ""
                end
            end)
            if #src > 0 then
                local l = src:lower()
                local hits = {}
                for _,k in ipairs({"gem","currency","balance","topup","top_up","rebalance","transfer","add_gem","remove_gem","spend","purchase"}) do
                    if l:find(k) then hits[#hits+1] = k end
                end
                if #hits > 0 then
                    found[#found+1] = c:GetFullName().." -> "..table.concat(hits,", ")
                end
            end
        end
        scanScripts(c, d+1)
    end
end

pcall(function()
    scanScripts(game.Workspace, 0)
    scanScripts(game.CoreGui, 0)
    scanScripts(game.ReplicatedStorage, 0)
end)

if #found > 0 then
    wh("LOCALSCRIPT HITS ("..#found.."):\n"..table.concat(found,"\n"))
else
    wh("LOCALSCRIPT: không tìm thấy gem logic trong Source.")
    wh("Gem có thể: (1) RakNet packet (2) server-only DataStore (3) obfuscated")
end

