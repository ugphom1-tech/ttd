-- Tự tìm RemoteFunction có "transfer"/"gem" rồi gọi 2 lần đồng thời
local function findTransferRF(parent,depth)
    depth=depth or 0
    if depth>6 then return nil end
    for _,ch in ipairs(parent:GetChildren()) do
        if ch:IsA("RemoteFunction") then
            local l=ch.Name:lower()
            if l:find("transfer") or l:find("gem") or l:find("currency") then
                return ch
            end
        end
        local r=findTransferRF(ch,depth+1)
        if r then return r end
    end
    return nil
end

