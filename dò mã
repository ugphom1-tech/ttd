local kw={"gem","coin","cash","reward","claim","daily","spin","crate","case","box","buy","sell","trade","exch","convert","gift","bonus","boost","free","pack","egg","roll","open","collect","quest","code","money","token","wheel","lucky"}
local calls={} local rows={}
local function hit(s) local l=s:lower() for i=1,#kw do if l:find(kw[i],1,true) then return true end end return false end
local function desc(a) local t=type(a) if t=="string" then return ("%q"):format(a:sub(1,36)) end if t=="number" or t=="boolean" then return tostring(a) end if t=="Instance" then local ok,n=pcall(function() return a.Name end) return ok and ("<"..tostring(n)..">") or "<inst>" end if t=="table" then local n=0 for _ in pairs(a) do n=n+1 end return "<tbl:"..n..">" end return "<"..t..">" end
local function da(a) local o={} for i=1,math.min(a.n,6) do o[i]=desc(a[i]) end return table.concat(o,",") end
local function add(txt,c) local b=Instance.new("TextButton") b.Size=UDim2.new(1,-8,0,0) b.AutomaticSize=Enum.AutomaticSize.Y b.BackgroundColor3=c or Color3.fromRGB(24,24,32) b.BorderSizePixel=0 b.Font=Enum.Font.Code b.TextSize=10 b.TextWrapped=true b.TextXAlignment=Enum.TextXAlignment.Left b.TextColor3=Color3.fromRGB(200,215,205) b.Text="  "..txt b.Parent=log Instance.new("UICorner",b).CornerRadius=UDim.new(0,4) local pd=Instance.new("UIPadding") pd.PaddingTop=UDim.new(0,3) pd.Parent=b return b end
local function clear() for _,c in ipairs(log:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end rows={} end
local function path(o) local ok,p=pcall(function() return o:GetFullName() end) return ok and p or "?" end

local orig
if hookmetamethod then pcall(function() orig=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
local a=table.pack(...)
local r=orig(self,table.unpack(a,1,a.n))
local m=getnamecallmethod()
if m=="FireServer" or m=="InvokeServer" then
local nm="" pcall(function() nm=self.Name end)
local c=calls[self] if not c then c={n=0,no=0} calls[self]=c end
c.n=c.n+1 if a.n==0 then c.no=c.no+1 end c.last=da(a)
if a.n==0 or hit(nm) then add(">> "..nm.." "..m.."  "..c.last,Color3.fromRGB(28,44,58)) end
end
return r end)) end)

local function scan()
clear()
local list={}
local function col(root) for _,d in ipairs(root:GetDescendants()) do if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then list[#list+1]=d end end end
pcall(col,RS) pcall(col,WS)
local sc={}
for _,r in ipairs(list) do
local s=0
if hit(r.Name) then s=s+3 end
if r:IsA("RemoteFunction") then s=s+2 end
local c=calls[r]
if c then s=s+math.min(c.n,6) if c.no>0 then s=s+3 end end
if r.Parent and r.Parent.Name:lower():find("remote",1,true) then s=s+1 end
sc[#sc+1]={r=r,s=s}
end
table.sort(sc,function(a,b) return a.s>b.s end)
for i=1,math.min(#sc,40) do
local e=sc[i] local c=calls[e.r] or {n=0,no=0}
local b=add(("%d] %s (%s) call=%d noarg=%d %s"):format(e.s,e.r.Name,(e.r.ClassName:gsub("Remote","")),c.n,c.no,path(e.r)),e.s>=6 and Color3.fromRGB(58,42,20) or nil)
b.MouseButton1Click:Connect(function() if setclipboard then pcall(setclipboard,path(e.r)) st.Text="copied" end end)
rows[#rows+1]={r=e.r,p=path(e.r),s=e.s,n=e.r.Name,cls=e.r.ClassName,c=c.n,no=c.no}
end
st.Text=("remotes=%d suspect=%d"):format(#list,#sc)
end

local function probe()
task.spawn(function()
for _,e in ipairs(rows) do
if e.s>=6 and e.cls=="RemoteEvent" then
local ok=pcall(function() e.r:FireServer() end)
add((ok and "probe ok " or "probe FAIL ")..e.n,ok and Color3.fromRGB(24,44,28) or Color3.fromRGB(52,28,28))
task.wait(0.2)
end
end
st.Text="probe done"
end)
end

sb.MouseButton1Click:Connect(function() scan() probe() end)
