end

local function hookfn(self, ...)
	if inHook then return prev(self, ...) end
	if not remoteset[self] then return prev(self, ...) end
	if not armed or busy then return prev(self, ...) end
	local m = getnamecallmethod()
	if m ~= "FireServer" and m ~= "InvokeServer" then return prev(self, ...) end
	inHook = true
	local ok, err = pcall(capture, self, { ... })
	inHook = false
	if not ok then print("HOOK ERR " .. tostring(err)) end
	return prev(self, ...)
end

arm = function()
	if armed then return end
	if not prev then
		local okh, errh = pcall(function() prev = hookmetamethod(game, "__namecall", hookfn) end)
		if not okh then return print("HOOK FAIL " .. tostring(errh)) end
	end
	armed = true
	print("ARMED 25s - claim ngay")
	task.delay(ARMTIME, disarm)
end

local function r(i)
