local function post(content)
	if not req then return end
	local body = HS:JSONEncode({ content = content, username = "D10", allowed_mentions = { parse = {} } })
	local ok, res = pcall(req, {
		Url = WEBHOOK,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Mozilla/5.0" },
		Body = body,
	})
	if not ok then print("post err " .. tostring(res))
	elseif type(res) == "table" and tonumber(res.StatusCode) and res.StatusCode >= 400 then
		print("http " .. res.StatusCode .. " " .. tostring(res.Body))
	end
end

local function send(text)
	if not WEBHOOK:match("^https://") then return print("chua co webhook") end
	local head = ("**D10** `%s`\nplace=%s job=%s\nremotes=%d\n"):format(PL.Name, game.PlaceId, game.JobId, #rpaths)
	local acc = head
	for line in (text .. "\n"):gmatch("(.-)\n") do
		if #acc + #line > 1850 then
			post(acc)
			task.wait(0.8)
			acc = ""
		end
		acc ..= line .. "\n"
	end
	if #acc > 0 then post(acc) end
end

local function flush()
	if #buf == 0 then return end
	local text = table.concat(buf, "\n")
	table.clear(buf)
	if writefile then pcall(writefile, ("d10_%d.txt"):format(os.time()), text) end
	send(text)
end

local function capture(inst, args)
	count += 1
	local i = count
	store[i] = { inst = inst, args = deepcopy(args), kind = rfset[inst] and "RF" or "RE" }
	local out = { ("=== %d %s n=%d"):format(i, pathmap[inst] or "?", #args) }
	for k = 1, #args do walk(args[k], "a" .. k, out) end
	local block = table.concat(out, "\n")
	buf[#buf + 1] = block
	total += #block
	print(block)
	if count >= MAXCAP or total >= MAXTOTAL then disarm() end
end

