		if rec.kind == "RF" then rec.inst:InvokeServer(unpack(rec.args))
		else rec.inst:FireServer(unpack(rec.args)) end
	end)
	busy = false
	print(ok and "replay ok" or ("replay err " .. tostring(err)))
end

local function d(i)
